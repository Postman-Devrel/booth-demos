.DS_Store
.claude/settings.local.json
content/*/*/.demo-state

# Project-scoped MCP servers added live during a session; teardown.sh removes these.
content/*/*/.mcp.json
content/*/*/.mcp.dryrun.json
content/*/*/.mcp.offline.json

# Provisioned live-authoring workspace for the fern talk. setup.sh --authoring
# recreates it on demand; nothing here is hand-authored.
content/*/*/workspace/

# Recorded offline fallbacks. Regenerated in ~60s by refresh-fixtures.sh, and
# they vendor third-party documentation, so they are not checked in.
# fixtures/baseline.tsv IS tracked — it is our own measurement and the scorecard
# quotes its median on stage.
content/*/*/fixtures/snapshots/
content/*/*/fixtures/corpus/

# Retired demo, local fixtures only.
demos/
